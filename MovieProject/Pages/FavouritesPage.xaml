<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MovieProject.Pages.FavouritesPage"
    Title="Favourites">

    <CollectionView
        x:Name="FavouritesCollectionView"
        SelectionMode="Single"
        SelectionChanged="OnMovieSelected">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <HorizontalStackLayout Padding="10" Spacing="15">
                    <Label Text="{Binding Emoji}" FontSize="36"/>
                    <VerticalStackLayout>
                        <Label Text="{Binding Title}"
                               FontAttributes="Bold"
                               FontSize="18"/>
                        <Label Text="{Binding Year}"
                               FontSize="14"
                               TextColor="Gray"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
