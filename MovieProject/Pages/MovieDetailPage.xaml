<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovieProject.Pages.MovieDetailPage"
             Title="Movie Details">
    <VerticalStackLayout Padding="24" Spacing="16">

        <Label Text="{Binding Emoji}" FontSize="72" HorizontalOptions="Center"/>
        <Label Text="{Binding Title}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
        <Label Text="{Binding Year}" FontSize="18" HorizontalOptions="Center"/>
        <Label Text="{Binding GenreString}" FontSize="16" HorizontalOptions="Center"/>
        <Label Text="{Binding Director}" FontSize="16" HorizontalOptions="Center"/>
        <Label Text="{Binding Rating}" FontSize="16" HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentPage>